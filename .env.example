# Main bot
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=123456789012345678

# Wallet
SEED_PHRASE=your twenty four word seed phrase here

# Blockchain APIs (optional, used for payment detection)
BLOCKCYPHER_TOKEN=your_blockcypher_token_here
SOCHAIN_API_KEY=your_sochain_api_key_here

# Admin security
ADMIN_USER_IDS=123456789012345678,987654321098765432
ADMIN_PIN_HASH=your_sha256_hex_here
PIN_MAX_ATTEMPTS_PER_MINUTE=5

# Staff notifications
STAFF_ROLE_ID=1234567890123456789
STAFF_NOTIFY_CHANNEL_ID=9876543210987654321

# Backups - local
BACKUP_JSON_PATH=backup/backup.json
BACKUP_TXT_PATH=backup/backup.txt
MIN_BACKUP_SUCCESS=3

# Backups - Discord webhook
DISCORD_BACKUP_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Backups - Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Rate limits
CHANNEL_DELETE_DELAY_SECONDS=60
DEAL_RATE_LIMIT_PER_HOUR=5
DEAL_RATE_LIMIT_PER_DAY=12
MAX_CONCURRENT_DEALS=14

# Second "link" bot
LINKBOT_TOKEN=your_second_bot_token_here
MEMBER_ROLE_ID=1234567890123456789
STATUS_TRIGGER=.gg/yourinvite
SCAN_INTERVAL_MINUTES=10
SCAN_CHUNK_SIZE=50
SCAN_CHUNK_DELAY_SECONDS=1
AUTO_REMOVE_ROLE=true
